# CMA/CA region-chunked run — Canada, with CHM canopy stats included.
#
# Buildings file here is NOT the raw OBPL export — it's
# data/canada_cma_ca_buildings_chm.gpkg, built by
# scripts/build_cma_ca_buildings_chm.py, which joins:
#   - chm_mean/chm_std/chm_max/chm_cover + CMAUID/CMANAME/CMATYPE
#     (from the separate 156-city CHM pipeline, output/final/combined_chm_stats_cma_ca.parquet)
#   - HEIGHT + the other OBPL attributes
#     (from data/OBPL_CA_v3_Footprints_Canada, joined back in by BLDG_ID)
# The 156-city CHM run only covers buildings inside CMA/CA boundaries, which
# is exactly the region set this config chunks over — see --regions-shapefile
# below. Buildings outside every CMA/CA (~24% of the country, but sparse
# rural land — see the earlier province/CD discussion) are not in this file
# and are out of scope for this run; use config/canada.env for a full-country
# pass instead.
#
# Run:
#   .venv\Scripts\python.exe scripts\run_pipeline_buildings.py --config config/canada_cma_ca.env ^
#       --regions-shapefile data\CMA_CA_boundaries.gdb --region-id-col CMAUID --timeout -1
#
# (--regions-shapefile / --region-id-col are CLI flags, not config values —
# scripts/region_pipeline.py reads a GDAL-openable dataset, and pyogrio reads
# a File Geodatabase's layer directly, so pointing straight at the .gdb
# folder works without extracting a layer to its own file first.)

CITY_NAME=Canada
CITY_SLUG=canada_cma_ca

# Projected CRS for all spatial analysis (must be in metres).
TARGET_CRS=EPSG:3979

# --- Input data paths (relative to project root) ---
BUILDINGS_FILE=data\\canada_cma_ca_buildings_chm.gpkg
BUILDINGS_LAYER=buildings_chm_stats
# Only used if you run this config WITHOUT --regions-shapefile (falls back to
# a single whole-country run) — region-chunked mode overrides this per region.
BOUNDARY_FILE=data\\canada_boundary\\canada_Canada_Country_Boundary\\canada_Canada_Country_Boundary.shp
ROADS_FILE=data\\ca_streets.gpkg

# --- CHM (LiDAR canopy height model) ---
# This is the whole point of this config vs. config/canada.env: CHM stats
# are actually present here, so include them.
INCLUDE_CHM=0
CHM_COLS=chm_mean,chm_std,chm_max,chm_cover

# --- Geometry cleaning parameters (notebook 01) ---
SIMPLIFICATION_TOLERANCE=0.1
MERGE_LIMIT=25
MAX_BUILDING_AREA=200000

# --- Output ---
# Separate from outputs_canada/ (the census-division run) so the two don't
# clobber each other — they're different building sets and different region
# chunking schemes.
OUTPUT_ROOT=outputs_canada_cma_ca_nochm
