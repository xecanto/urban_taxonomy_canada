# Template city config for the buildings taxonomy pipeline.
# Copy this file to config/<yourcity>.env and fill in the values, then run:
#   .venv\Scripts\python.exe scripts\run_pipeline_buildings.py --config config/<yourcity>.env
# (or set CITY_CONFIG=config/<yourcity>.env before launching Jupyter to run
# notebooks_buidings/*.ipynb interactively against this config).
CITY_NAME=Halifax
CITY_SLUG=halifax

# Projected CRS for all spatial analysis (must be in metres, local to the city).
TARGET_CRS=EPSG:8083

# --- Input data paths (relative to project root) ---
# Buildings footprints, optionally pre-enriched with CHM canopy stats.
BUILDINGS_FILE=data\\10-fastest-growing-cities-Canada\\4. Halifax\\Buildings_Pop_Halifax.gpkg
BUILDINGS_LAYER=main.Buildings_Pop_Halifax
BOUNDARY_FILE=data\\10-fastest-growing-cities-Canada\\4. Halifax\\Boundary_Halifax.shp
ROADS_FILE=data\\10-fastest-growing-cities-Canada\\4. Halifax\\Streets_Halifax.gpkg

# --- CHM (LiDAR canopy height model) ---
# Set to 0/false if this city has no LiDAR/CHM coverage — the pipeline will
# skip canopy attributes entirely.
INCLUDE_CHM=0
CHM_COLS=chm_mean,chm_std,chm_max,chm_cover

# --- Geometry cleaning parameters (notebook 01) ---
SIMPLIFICATION_TOLERANCE=0.1
MERGE_LIMIT=25
MAX_BUILDING_AREA=200000

# --- Output ---
# Root folder (relative to project root) all pipeline outputs are written under.
# Use a city-specific folder so runs for different cities don't overwrite each other.
OUTPUT_ROOT=outputs_halifax