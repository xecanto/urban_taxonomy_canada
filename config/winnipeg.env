# City config for the buildings taxonomy pipeline — Winnipeg, Canada.
# Loaded by scripts/pipeline_config.py at the top of every notebooks_buidings/*.ipynb
# (and by scripts/run_pipeline_buildings.py before it launches them).
#
# To run the pipeline for a different city: copy this file, edit the values,
# then either set CITY_CONFIG=config/<yourcity>.env before launching Jupyter,
# or pass --config config/<yourcity>.env to run_pipeline_buildings.py.

CITY_NAME=Winnipeg
CITY_SLUG=winnipeg

# Projected CRS for all spatial analysis (must be in metres).
TARGET_CRS=EPSG:3978

# --- Input data paths (relative to project root) ---
BUILDINGS_FILE=data/winnipeg_buildings_chm_stats.gpkg
BUILDINGS_LAYER=buildings_chm_stats
BOUNDARY_FILE=data/winnipeg_boundry.gpkg
ROADS_FILE=data/winnipeg_roads.gpkg
# Column holding the OSM road classification. Varies by extract/tool —
# usually "fclass", sometimes "highway". Notebook 01 auto-falls-back to the
# other common name if this one isn't found.
ROAD_CLASS_COL=fclass

# --- CHM (LiDAR canopy height model) ---
# Set to 0/false to exclude CHM canopy attributes from the whole pipeline
# (e.g. no LiDAR coverage for this city).
INCLUDE_CHM=1
# Column names must match fields in BUILDINGS_FILE.
CHM_COLS=chm_mean,chm_std,chm_max,chm_cover

# --- Geometry cleaning parameters (notebook 01) ---
SIMPLIFICATION_TOLERANCE=0.1
MERGE_LIMIT=25
MAX_BUILDING_AREA=200000

# --- Output ---
# Root folder (relative to project root) all pipeline outputs are written under.
# Change this per city so runs don't clobber each other, e.g. outputs_calgary.
OUTPUT_ROOT=outputs_winnipeg
